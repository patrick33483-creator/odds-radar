# Dashboard login. Use long, unique values on the server.
RADAR_ACCESS_USER=radar
RADAR_ACCESS_PASSWORD=replace-with-a-long-random-password

# Persistent scanning policy.
RADAR_AUTO_SCAN=1
RADAR_HOURLY_PREWARM=1
RADAR_BOOTSTRAP=1
RADAR_SCAN_WINDOW_MIN=30
RADAR_SCAN_INTERVAL_SEC=30
RADAR_SIM_TARGET=0
RADAR_DEMO=0

# PinnAPI Edge. Never commit the real key.
PINNAPI_API_KEY=replace-with-pinnapi-edge-key
PINNAPI_BASE_URL=https://pinnapi.com

# Optional Telegram notification delivery.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Optional provider overrides.
PINNACLE_TITAN_COMPANY_ID=47

